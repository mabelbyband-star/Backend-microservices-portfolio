name: Docker Build Check

on:
  push:
    branches:
      - main

jobs:
  build:
    runs-on: ubuntu-latest

    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_DB: notesdb
          POSTGRES_USER: myuser
          POSTGRES_PASSWORD: mypassword
        ports:
          - 5432:5432
        options: >-
          --health-cmd pg_isready
          --health-interval 10s
          --health-timeout 5s
          --health-retries 5

    steps:
      - name: Check out code
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.12'

      - name: Install dependencies
        run: pip install -r notes-app/requirements.txt

      - name: Run tests
        working-directory: ./notes-app
        env:
          DB_HOST: localhost
        run: pytest

      - name: Log in to Docker Hub
        uses: docker/login-action@v3
        with:
          username: ${{ secrets.DOCKERHUB_USERNAME }}
          password: ${{ secrets.DOCKERHUB_TOKEN }}

      - name: Build and push Docker image
        uses: docker/build-push-action@v6
        with:
          context: ./notes-app
          push: true
          tags: ${{ secrets.DOCKERHUB_USERNAME }}/notes-app:latest

#What each part means:

#on: push: branches: [main] — this pipeline runs automatically every time you push to the main branch
#runs-on: ubuntu-latest — GitHub spins up a fresh Linux machine to run this on (you don't manage it, it's temporary and free for public repos)
#actions/checkout@v4 — a ready-made step that pulls your repo's code onto that machine
#docker build -t notes-app ./notes-app — the exact same build command you've been running by hand, just automated
git add
